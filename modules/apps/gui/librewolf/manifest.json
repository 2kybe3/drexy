{
    "manifest_version": 3,
    "version": "1.0",
    "name": "kybe - theme",
    "description": "kybe - theme",
    "browser_specific_settings": {
        "gecko": {
            "id": "kybe@kybe.xyz",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        }
    },
    "theme": {
        "colors": {
            "sidebar": "@base00@",
            "frame": "@base00@",
            "tab_background_text": "@base05@",
            "toolbar": "@base00@",
            "toolbar_field": "@base00@",
            "toolbar_field_text": "@base05@",
            "toolbar_field_border": "@base06@",
            "toolbar_bottom_separator": "@base06@",
            "icons": "@base06@",
            "tab_line": "@base06@",
            "popup": "@base00@",
            "popup_text": "@base05@",
            "popup_border": "@base00@",
            "ntp_background": "@base00@",
            "ntp_text": "@base05@"
        }
    }
}
